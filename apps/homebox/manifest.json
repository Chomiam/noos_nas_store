{
  "id": "homebox",
  "name": "Homebox",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "Inventory and organization system built for the home user",
  "description": "Inventory and organization system built for the home user. Source: https://github.com/sysadminsmedia/homebox",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/151488376",
  "default_port": 7745,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/data",
      "container": "/data",
      "description": "Dossier /data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}