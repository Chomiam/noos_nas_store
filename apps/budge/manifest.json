{
  "id": "budge",
  "name": "Budge",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "[Budge](https://github",
  "description": "[Budge](https://github.com/linuxserver/budge) is an open source 'budgeting with envelopes' personal finance app.",
  "website": "",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/budge.png",
  "default_port": 80,
  "extra_ports": [
    443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}