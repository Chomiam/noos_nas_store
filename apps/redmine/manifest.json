{
  "id": "redmine",
  "name": "Redmine",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source project management tool",
  "description": "Open-source project management tool",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/redmine.png",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/usr_src_redmine_files",
      "container": "/usr/src/redmine/files",
      "description": "Dossier /usr/src/redmine/files"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}