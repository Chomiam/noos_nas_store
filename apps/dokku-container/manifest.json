{
  "id": "dokku-container",
  "name": "Dokku (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Dokku setup as a container",
  "description": "Dokku setup as a container",
  "website": "",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/dokku-container.png",
  "default_port": 22,
  "extra_ports": [
    80,
    443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/mnt/dokku",
      "description": "Dossier /mnt/dokku"
    },
    {
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "description": "Dossier /var/run/docker.sock"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "DOKKU_HOSTNAME",
      "label": "Dokku hostname",
      "default": ""
    },
    {
      "name": "DOKKU_HOST_ROOT",
      "label": "Dokku host root",
      "default": "/var/lib/dokku/home/dokku"
    }
  ]
}