{
  "id": "dradis",
  "name": "Dradis",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "Dradis Framework: Collaboration and reporting for IT Security teams http://dradisframework",
  "description": "Dradis Framework: Collaboration and reporting for IT Security teams http://dradisframework.org",
  "website": "",
  "icon": "https://raw.githubusercontent.com/SelfhostedPro/selfhosted_templates/master/Images/dradis-logo.png",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}