{
  "id": "dockge",
  "name": "Dockge",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A fancy, easy-to-use and reactive self-hosted docker compose",
  "description": "A fancy, easy-to-use and reactive self-hosted docker compose.yaml stack-oriented manager.",
  "website": "",
  "icon": "https://github.com/louislam/dockge/raw/master/frontend/public/icon.svg",
  "default_port": 5001,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}