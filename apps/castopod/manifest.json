{
  "id": "castopod",
  "name": "Castopod",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Castopod is a free and open-source hosting platform made for podcasters",
  "description": "Castopod is a free and open-source hosting platform made for podcasters.",
  "website": "",
  "icon": "https://pbs.twimg.com/profile_images/1313854745161932800/w_qe6Qq6_400x400.png",
  "default_port": 8848,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}