{
  "id": "valheim-server-docker",
  "name": "Valheim Server",
  "version": "latest",
  "category": "Jeux & Divertissement",
  "tagline": "Valheim dedicated gameserver in Docker with full modding support",
  "description": "Valheim dedicated gameserver in Docker with full modding support. Source: https://github.com/lloesche/valheim-server-docker",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/82116562",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}