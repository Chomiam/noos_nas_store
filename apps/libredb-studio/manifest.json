{
  "id": "libredb-studio",
  "name": "LibreDB Studio",
  "version": "latest",
  "category": "Développement",
  "tagline": "Web-based SQL IDE for sixteen database engines, with a schema browser, ER diagrams and query history",
  "description": "Web-based SQL IDE for sixteen database engines, with a schema browser, ER diagrams and query history. Source: https://github.com/libredb/libredb-studio",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/251081537",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/app_data",
      "container": "/app/data",
      "description": "Dossier /app/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}