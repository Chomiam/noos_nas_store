{
  "id": "grafana-dashboard",
  "name": "Grafana Dashboard",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Multi-platform open-source interactive visualization web application",
  "description": "Multi-platform open-source interactive visualization web application",
  "website": "",
  "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/a1/Grafana_logo.svg/1200px-Grafana_logo.svg.png",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}