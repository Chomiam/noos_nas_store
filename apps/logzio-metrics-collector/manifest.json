{
  "id": "logzio-metrics-collector",
  "name": "Logzio Metrics Collector",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Docker Metrics Collector is a container that runs Metricbeat with the modules you enable at runtime",
  "description": "Docker Metrics Collector is a container that runs Metricbeat with the modules you enable at runtime.",
  "website": "",
  "icon": "https://mediadepot.github.io/templates/img/logzio-icon.png",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "description": "Dossier /var/run/docker.sock"
    },
    {
      "host": "./data/cgroup",
      "container": "/hostfs/sys/fs/cgroup",
      "description": "Dossier /hostfs/sys/fs/cgroup"
    },
    {
      "host": "./data/proc",
      "container": "/hostfs/proc",
      "description": "Dossier /hostfs/proc"
    },
    {
      "host": "./data/config",
      "container": "/hostfs",
      "description": "Dossier /hostfs"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "LOGZIO_TOKEN",
      "label": "LOGZIO_TOKEN",
      "default": "REPLACE-LOGZIO-TOKEN-HERE"
    },
    {
      "name": "LOGZIO_MODULES",
      "label": "LOGZIO_MODULES",
      "default": "system,docker"
    }
  ]
}