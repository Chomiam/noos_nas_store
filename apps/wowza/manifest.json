{
  "id": "wowza",
  "name": "Wowza",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "Streaming media server",
  "description": "Streaming media server",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/wowza.png",
  "default_port": 1935,
  "extra_ports": [
    8086,
    8087,
    8088
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_wowza",
      "container": "/var/lib/wowza",
      "description": "Dossier /var/lib/wowza"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "WOWZA_ACCEPT_LICENSE",
      "label": "Agree to Wowza EULA",
      "default": "yes"
    },
    {
      "name": "WOWZA_KEY",
      "label": "License key",
      "default": ""
    }
  ]
}