{
  "id": "neko",
  "name": "Neko",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Simple room management system for n",
  "description": "Simple room management system for n.eko. Self hosted rabb.it alternative. --Please add .env file as stated in neko.yml",
  "website": "",
  "icon": "https://raw.githubusercontent.com/m1k1o/neko/master/docs/_media/logo.png",
  "default_port": 580,
  "extra_ports": [
    5443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}