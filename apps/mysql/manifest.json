{
  "id": "mysql",
  "name": "MySQL (stack)",
  "version": "latest",
  "category": "Développement",
  "tagline": "MySQL 8",
  "description": "MySQL 8.4 LTS - the world's most popular open- source relational database, as a single self-hosted node. Configured entirely through the official image's environment variables, with data on a volume.",
  "website": "",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/mysql.png",
  "default_port": 3306,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}