{
  "id": "pairdrop",
  "name": "PairDrop",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "Local file sharing in your browser, inspired by Apple's AirDrop",
  "description": "Local file sharing in your browser, inspired by Apple's AirDrop. Source: https://github.com/schlagmichdoch/PairDrop",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/52242352",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}