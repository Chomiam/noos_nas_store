{
  "id": "couchpotato",
  "name": "CouchPotato",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "CouchPotato (CP) is an automatic NZB and torrent downloader",
  "description": "CouchPotato (CP) is an automatic NZB and torrent downloader. You can keep a \"movies I want\"-list and it will search for NZBs/torrents of these movies every X hours. Once a movie is found, it will send it to SABnzbd or download the torrent to a specified directory.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/xneo1/portainer_templates/master/Images/couchpotato-icon.png",
  "default_port": 5050,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/Couchpotato",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/Downloads",
      "container": "/downloads",
      "description": "Dossier /downloads"
    },
    {
      "host": "./data/Movies",
      "container": "/movies",
      "description": "Dossier /movies"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}