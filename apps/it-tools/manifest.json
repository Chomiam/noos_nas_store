{
  "id": "it-tools",
  "name": "IT-Tools",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Collection of handy online tools for developers, with great UX",
  "description": "Collection of handy online tools for developers, with great UX. Source: https://github.com/CorentinTh/it-tools",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/25065347",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}