{
  "id": "gatus",
  "name": "Gatus",
  "version": "latest",
  "category": "Administration & Monitoring",
  "tagline": "Automated developer-oriented status page with highly configurable health checks",
  "description": "Automated developer-oriented status page with highly configurable health checks. Source: https://github.com/TwiN/gatus",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/15699766",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}