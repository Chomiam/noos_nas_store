{
  "id": "netbox",
  "name": "Netbox",
  "version": "latest",
  "category": "Administration & Monitoring",
  "tagline": "[Netbox](https://github",
  "description": "[Netbox](https://github.com/netbox-community/netbox) is an IP address management (IPAM) and data center infrastructure management (DCIM) tool. Initially conceived by the network engineering team at DigitalOcean, NetBox was developed specifically to address the needs of network and infrastructure engineers. It is intended to function as a domain-specific source of truth for network operations.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/netbox-logo.png",
  "default_port": 8000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "SUPERUSER_EMAIL",
      "label": "SUPERUSER_EMAIL",
      "default": ""
    },
    {
      "name": "SUPERUSER_PASSWORD",
      "label": "SUPERUSER_PASSWORD",
      "default": ""
    },
    {
      "name": "ALLOWED_HOST",
      "label": "ALLOWED_HOST",
      "default": ""
    },
    {
      "name": "DB_NAME",
      "label": "DB_NAME",
      "default": ""
    },
    {
      "name": "DB_USER",
      "label": "DB_USER",
      "default": ""
    },
    {
      "name": "DB_PASSWORD",
      "label": "DB_PASSWORD",
      "default": ""
    },
    {
      "name": "DB_HOST",
      "label": "DB_HOST",
      "default": ""
    },
    {
      "name": "DB_PORT",
      "label": "DB_PORT",
      "default": ""
    },
    {
      "name": "REDIS_HOST",
      "label": "REDIS_HOST",
      "default": ""
    },
    {
      "name": "REDIS_PORT",
      "label": "REDIS_PORT",
      "default": ""
    },
    {
      "name": "REDIS_USERNAME",
      "label": "REDIS_USERNAME",
      "default": ""
    },
    {
      "name": "REDIS_PASSWORD",
      "label": "REDIS_PASSWORD",
      "default": ""
    },
    {
      "name": "REDIS_DB_TASK",
      "label": "REDIS_DB_TASK",
      "default": ""
    },
    {
      "name": "REDIS_DB_CACHE",
      "label": "REDIS_DB_CACHE",
      "default": ""
    },
    {
      "name": "BASE_PATH",
      "label": "BASE_PATH",
      "default": ""
    },
    {
      "name": "CSRF_TRUSTED_ORIGINS",
      "label": "CSRF_TRUSTED_ORIGINS",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_ENABLED",
      "label": "REMOTE_AUTH_ENABLED",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_BACKEND",
      "label": "REMOTE_AUTH_BACKEND",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_HEADER",
      "label": "REMOTE_AUTH_HEADER",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_AUTO_CREATE_USER",
      "label": "REMOTE_AUTH_AUTO_CREATE_USER",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_DEFAULT_GROUPS",
      "label": "REMOTE_AUTH_DEFAULT_GROUPS",
      "default": ""
    },
    {
      "name": "REMOTE_AUTH_DEFAULT_PERMISSIONS",
      "label": "REMOTE_AUTH_DEFAULT_PERMISSIONS",
      "default": ""
    }
  ]
}