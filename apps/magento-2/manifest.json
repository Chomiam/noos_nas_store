{
  "id": "magento-2",
  "name": "Magento 2",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source e-commerce platform",
  "description": "Open-source e-commerce platform",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/magento.png",
  "default_port": 80,
  "extra_ports": [
    3000,
    3001
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_www_html",
      "container": "/var/www/html/",
      "description": "Dossier /var/www/html/"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}