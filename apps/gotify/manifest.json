{
  "id": "gotify",
  "name": "Gotify",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A simple server for sending and receiving messages",
  "description": "A simple server for sending and receiving messages",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/gotify.png",
  "default_port": 9008,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/gotify",
      "container": "/app/data",
      "description": "Dossier /app/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "GOTIFY_DEFAULTUSER_NAME",
      "label": "GOTIFY_DEFAULTUSER_NAME",
      "default": "admin"
    },
    {
      "name": "GOTIFY_DEFAULTUSER_PASS",
      "label": "GOTIFY_DEFAULTUSER_PASS",
      "default": "admin123"
    }
  ]
}