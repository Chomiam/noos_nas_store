{
  "id": "mealie",
  "name": "Mealie",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A self-hosted recipe manager and meal planner",
  "description": "A self-hosted recipe manager and meal planner",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/mealie.png",
  "default_port": 9925,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/mealie",
      "container": "/app/data",
      "description": "Dossier /app/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "WEB_CONCURRENCY",
      "label": "WEB_CONCURRENCY",
      "default": "2"
    },
    {
      "name": "MAX_WORKERS",
      "label": "MAX_WORKERS",
      "default": "8"
    },
    {
      "name": "RECIPE_PUBLIC",
      "label": "RECIPE_PUBLIC",
      "default": "true"
    },
    {
      "name": "RECIPE_SHOW_NUTRITION",
      "label": "RECIPE_SHOW_NUTRITION",
      "default": "true"
    },
    {
      "name": "RECIPE_SHOW_ASSETS",
      "label": "RECIPE_SHOW_ASSETS",
      "default": "true"
    },
    {
      "name": "RECIPE_LANDSCAPE_VIEW",
      "label": "RECIPE_LANDSCAPE_VIEW",
      "default": "true"
    },
    {
      "name": "RECIPE_DISABLE_COMMENTS",
      "label": "RECIPE_DISABLE_COMMENTS",
      "default": "false"
    },
    {
      "name": "RECIPE_DISABLE_AMOUNT",
      "label": "RECIPE_DISABLE_AMOUNT",
      "default": "false"
    }
  ]
}