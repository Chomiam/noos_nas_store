{
  "id": "rust-desk",
  "name": "Rust Desk (stack)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Rust Desk is an Open source virtual or remote desktop infrastructure for everyone!",
  "description": "Rust Desk is an Open source virtual or remote desktop infrastructure for everyone!",
  "website": "",
  "icon": "https://images.sftcdn.net/images/t_app-logo-xl,f_auto,dpr_2/p/735e7f11-0f1e-492d-bfa4-4be6eead5179/3131069239/rustdesk-unnamed.png",
  "default_port": 21115,
  "extra_ports": [
    21116,
    21116,
    21118
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}