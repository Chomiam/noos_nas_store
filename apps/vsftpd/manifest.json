{
  "id": "vsftpd",
  "name": "vsftpd FTP Server",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Secure, fast FTP server for UNIX-like systems",
  "description": "Secure, fast FTP server for UNIX-like systems",
  "website": "",
  "icon": "https://mediadepot.github.io/templates/img/pureftpd-icon.jpg",
  "default_port": 21,
  "extra_ports": [
    21000,
    21001,
    21002,
    21003,
    21004,
    21005,
    21006,
    21007,
    21008,
    21009,
    21010
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/tvshows",
      "container": "/home/depot/tvshows",
      "description": "Dossier /home/depot/tvshows"
    },
    {
      "host": "./data/movies",
      "container": "/home/depot/movies",
      "description": "Dossier /home/depot/movies"
    },
    {
      "host": "./data/music",
      "container": "/home/depot/music",
      "description": "Dossier /home/depot/music"
    },
    {
      "host": "./data/ebooks",
      "container": "/home/depot/ebooks",
      "description": "Dossier /home/depot/ebooks"
    },
    {
      "host": "./data/photos",
      "container": "/home/depot/photos",
      "description": "Dossier /home/depot/photos"
    },
    {
      "host": "./data/documents",
      "container": "/home/depot/documents",
      "description": "Dossier /home/depot/documents"
    },
    {
      "host": "./data/downloads",
      "container": "/home/depot/downloads",
      "description": "Dossier /home/depot/downloads"
    },
    {
      "host": "./data/software",
      "container": "/home/depot/software",
      "description": "Dossier /home/depot/software"
    },
    {
      "host": "./data/blackhole",
      "container": "/home/depot/blackhole",
      "description": "Dossier /home/depot/blackhole"
    },
    {
      "host": "./data/processing",
      "container": "/home/depot/processing",
      "description": "Dossier /home/depot/processing"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "ADDRESS",
      "label": "ADDRESS",
      "default": ""
    },
    {
      "name": "USERS",
      "label": "USERS",
      "default": "depot|badpass|/home/depot|15000"
    }
  ]
}