{
  "id": "flexget",
  "name": "Flexget",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "[Flexget](http://flexget",
  "description": "[Flexget](http://flexget.com/) is a multipurpose automation tool for all of your media.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/flexget-banner.png",
  "default_port": 5050,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/data",
      "container": "/data",
      "description": "Dossier /data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "FG_LOG_LEVEL",
      "label": "FG_LOG_LEVEL",
      "default": "info"
    },
    {
      "name": "FG_LOG_FILE",
      "label": "FG_LOG_FILE",
      "default": "/config/flexget.log"
    },
    {
      "name": "FG_CONFIG_FILE",
      "label": "FG_CONFIG_FILE",
      "default": "/config/.flexget/config.yml"
    },
    {
      "name": "FG_WEBUI_PASSWORD",
      "label": "FG_WEBUI_PASSWORD",
      "default": "info"
    }
  ]
}