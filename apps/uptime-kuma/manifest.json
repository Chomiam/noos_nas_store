{
  "id": "uptime-kuma",
  "name": "Uptime Kuma (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "It is a self-hosted monitoring tool like 'Uptime Robot'",
  "description": "It is a self-hosted monitoring tool like 'Uptime Robot'.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/uptime-kuma.png",
  "default_port": 3001,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/uptime-kuma",
      "container": "/app/data",
      "description": "Dossier /app/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}