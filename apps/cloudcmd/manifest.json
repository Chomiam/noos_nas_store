{
  "id": "cloudcmd",
  "name": "Cloud Commander",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Cloud Commander a file manager for the web with console and editor",
  "description": "Cloud Commander a file manager for the web with console and editor.",
  "website": "",
  "icon": "https://mediadepot.github.io/templates/img/cloudcmd-logo.png",
  "default_port": 8000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/apps",
      "container": "/media/host/opt/mediadepot",
      "description": "Dossier /media/host/opt/mediadepot"
    },
    {
      "host": "./data/storage",
      "container": "/media/host/media/storage",
      "description": "Dossier /media/host/media/storage"
    },
    {
      "host": "./data/temp",
      "container": "/media/host/media/temp",
      "description": "Dossier /media/host/media/temp"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}