{
  "id": "trilium",
  "name": "Trilium",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "Trilium Notes is a hierarchical note taking application with focus on building large personal knowledge bases",
  "description": "Trilium Notes is a hierarchical note taking application with focus on building large personal knowledge bases",
  "website": "",
  "icon": "https://www.saashub.com/images/app/service_logos/55/2901389fab77/large.png?1561117248",
  "default_port": 3388,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/trilium-data",
      "container": "/home/node/trilium-data",
      "description": "Dossier /home/node/trilium-data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "TRILIUM_DATA_DIR",
      "label": "TRILIUM_DATA_DIR",
      "default": "/home/node/trilium-data"
    },
    {
      "name": "PORT",
      "label": "PORT",
      "default": ""
    }
  ]
}