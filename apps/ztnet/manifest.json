{
  "id": "ztnet",
  "name": "ZTNet",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "ZeroTier network controller with a web UI",
  "description": "ZeroTier network controller with a web UI. Source: https://github.com/sinamics/ztnet",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/4173285",
  "default_port": 9993,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}