{
  "id": "ghost-container",
  "name": "Ghost (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Free and open-source blogging platform",
  "description": "Free and open-source blogging platform",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/ghost.png",
  "default_port": 2368,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_ghost_content",
      "container": "/var/lib/ghost/content",
      "description": "Dossier /var/lib/ghost/content"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}