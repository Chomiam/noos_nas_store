{
  "id": "midarr",
  "name": "Midarr",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "Your media enjoyed through a minimal lightweight media server",
  "description": "Your media enjoyed through a minimal lightweight media server.",
  "website": "",
  "icon": "https://github.com/midarrlabs/midarr-server/raw/master/priv/static/logo.svg",
  "default_port": 4000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}