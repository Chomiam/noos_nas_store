{
  "id": "netdata",
  "name": "Netdata",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Troubleshoot slowdowns and anomalies in your infrastructure with thousands of per-second metrics, meaningful visualizati",
  "description": "Troubleshoot slowdowns and anomalies in your infrastructure with thousands of per-second metrics, meaningful visualizations, and insightful health alarms with zero configuration.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/netdata.png",
  "default_port": 19999,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/netdata/netdataconfig",
      "container": "/etc/netdata",
      "description": "Dossier /etc/netdata"
    },
    {
      "host": "./data/netdata/netdatalib",
      "container": "/var/lib/netdata",
      "description": "Dossier /var/lib/netdata"
    },
    {
      "host": "./data/passwd",
      "container": "/host/etc/passwd:ro",
      "description": "Dossier /host/etc/passwd:ro"
    },
    {
      "host": "./data/group",
      "container": "/host/etc/group:ro",
      "description": "Dossier /host/etc/group:ro"
    },
    {
      "host": "./data/proc",
      "container": "/host/proc:ro",
      "description": "Dossier /host/proc:ro"
    },
    {
      "host": "./data/sys",
      "container": "/host/sys:ro",
      "description": "Dossier /host/sys:ro"
    },
    {
      "host": "./data/os-release",
      "container": "/host/etc/os-release:ro",
      "description": "Dossier /host/etc/os-release:ro"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "DOCKER_USR",
      "label": "DOCKER_USR",
      "default": "1000"
    },
    {
      "name": "DOCKER_GRP",
      "label": "DOCKER_GRP",
      "default": "1000"
    }
  ]
}