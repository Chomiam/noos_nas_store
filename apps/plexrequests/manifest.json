{
  "id": "plexrequests",
  "name": "Plex Requests",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "Simple automated way for users to request new content for Plex",
  "description": "Simple automated way for users to request new content for Plex.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/linuxserver/beta-templates/master/lsiodev/img/plexrequests-icon.png",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/PlexRequests",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "URL_BASE",
      "label": "URL_BASE",
      "default": ""
    }
  ]
}