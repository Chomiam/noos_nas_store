{
  "id": "searxng",
  "name": "SearXNG (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-Source Privacy-respecting metasearch engine",
  "description": "Open-Source Privacy-respecting metasearch engine",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/searx.png",
  "default_port": 9017,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/searxng",
      "container": "/etc/searxng",
      "description": "Dossier /etc/searxng"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "BASE_URL",
      "label": "BASE_URL",
      "default": "http://localhost:9017"
    },
    {
      "name": "INSTANCE_NAME",
      "label": "INSTANCE_NAME",
      "default": "my-instance"
    }
  ]
}