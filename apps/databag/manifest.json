{
  "id": "databag",
  "name": "Databag",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A lightweight federated messaging service",
  "description": "A lightweight federated messaging service. Source: https://github.com/balzack/databag",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/108325695",
  "default_port": 7000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}