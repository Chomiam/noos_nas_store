{
  "id": "aria2-pro",
  "name": "Aria2 Pro",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "A perfect Aria2 Docker image",
  "description": "A perfect Aria2 Docker image. Out of the box, just add download tasks and don't need to think about anything else.",
  "website": "",
  "icon": "https://imgcdn.p3terx.com/post/20201113041845.jpg",
  "default_port": 6800,
  "extra_ports": [
    6888,
    6888
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}