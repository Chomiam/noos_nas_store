{
  "id": "wger",
  "name": "Wger",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Self hosted FLOSS fitness/workout, nutrition and weight tracker written with Django",
  "description": "Self hosted FLOSS fitness/workout, nutrition and weight tracker written with Django",
  "website": "",
  "icon": "https://raw.githubusercontent.com/wger-project/wger/master/wger/core/static/images/logos/logo.png",
  "default_port": 8000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}