{
  "id": "pihole",
  "name": "Pi-Hole",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A Linux network-level advertisement and Internet tracker blocking application which acts as a DNS sinkhole",
  "description": "A Linux network-level advertisement and Internet tracker blocking application which acts as a DNS sinkhole.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/xneo1/portainer_templates/master/Images/pihole.png",
  "default_port": 53,
  "extra_ports": [
    67,
    1010,
    4443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/PiHole",
      "container": "/etc/pihole",
      "description": "Dossier /etc/pihole"
    },
    {
      "host": "./data/PiHole/DNS",
      "container": "/etc/dnsmasq.d",
      "description": "Dossier /etc/dnsmasq.d"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}