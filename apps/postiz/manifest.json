{
  "id": "postiz",
  "name": "Postiz",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "An alternative to: Buffer",
  "description": "An alternative to: Buffer.com, Hypefury, Twitter Hunter, etc...Postiz offers everything you need to manage your social media posts,build an audience, capture leads, and grow your business.",
  "website": "",
  "icon": "https://docs.postiz.com/_next/image?url=%2Flogo%2Fdark.png&w=256&q=75",
  "default_port": 5000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}