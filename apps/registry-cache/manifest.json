{
  "id": "registry-cache",
  "name": "Registry (cache)",
  "version": "latest",
  "category": "Administration & Monitoring",
  "tagline": "Docker image registry configured as a DockerHub pull through cache",
  "description": "Docker image registry configured as a DockerHub pull through cache",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/registry.png",
  "default_port": 5000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_registry",
      "container": "/var/lib/registry",
      "description": "Dossier /var/lib/registry"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "REGISTRY_PROXY_REMOTEURL",
      "label": "REGISTRY_PROXY_REMOTEURL",
      "default": "https://registry-1.docker.io"
    }
  ]
}