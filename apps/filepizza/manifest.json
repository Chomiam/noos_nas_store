{
  "id": "filepizza",
  "name": "Filepizza",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "Peer-to-peer file transfers in your browser",
  "description": "Peer-to-peer file transfers in your browser",
  "website": "",
  "icon": "https://raw.githubusercontent.com/kern/filepizza/master/src/static/images/wordmark.png",
  "default_port": 3333,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}