{
  "id": "tubearchivist",
  "name": "Tubearchivist",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "Tubearchivist is your self hosted YouTube media server",
  "description": "Tubearchivist is your self hosted YouTube media server",
  "website": "",
