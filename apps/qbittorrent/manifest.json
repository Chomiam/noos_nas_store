{
  "id": "qbittorrent",
  "name": "Qbittorrent",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "The [Qbittorrent](https://www",
  "description": "The [Qbittorrent](https://www.qbittorrent.org/) is a bittorrent client programmed in C++ / Qt that uses libtorrent (sometimes called libtorrent-rasterbar) by Arvid Norberg.",
  "website": "",
  "icon": "https://github.com/linuxserver/docker-templates/raw/master/linuxserver.io/img/qbittorrent-icon.png",
  "default_port": 8080,
  "extra_ports": [
    6881,
    6881
  ],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/downloads",
      "container": "/downloads",
      "description": "Dossier /downloads"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "WEBUI_PORT",
      "label": "WEBUI_PORT",
      "default": "8080"
    },
    {
      "name": "TORRENTING_PORT",
      "label": "TORRENTING_PORT",
      "default": "6881"
    }
  ]
}