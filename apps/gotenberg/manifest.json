{
  "id": "gotenberg",
  "name": "Gotenberg",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Docker-powered stateless API for PDF files: conversions, generation, merging, and more",
  "description": "Docker-powered stateless API for PDF files: conversions, generation, merging, and more. Source: https://github.com/gotenberg/gotenberg",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/66820499",
  "default_port": 3000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}