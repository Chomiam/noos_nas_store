{
  "id": "authelia",
  "name": "Authelia",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "An open-source authentication and authorization server providing 2-factor authentication and single sign-on (SSO) for yo",
  "description": "An open-source authentication and authorization server providing 2-factor authentication and single sign-on (SSO) for your applications via a web portal.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/xneo1/portainer_templates/master/Images/authelia.png",
  "default_port": 9091,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/Authelia",
      "container": "/etc/authelia/",
      "description": "Dossier /etc/authelia/"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}