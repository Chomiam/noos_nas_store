{
  "id": "technitium-dns",
  "name": "Technitium DNS",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "An open source authoritative and recursive DNS server with a web console for management",
  "description": "An open source authoritative and recursive DNS server with a web console for management. Source: https://github.com/TechnitiumSoftware/DnsServer",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/12230362",
  "default_port": 5380,
  "extra_ports": [
    53,
    53
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/etc_dns",
      "container": "/etc/dns",
      "description": "Dossier /etc/dns"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "DNS_SERVER_DOMAIN",
      "label": "Server domain/identity",
      "default": "dns-server"
    },
    {
      "name": "DNS_SERVER_ADMIN_PASSWORD",
      "label": "Web console admin password (first run only; blank = admin/admin)",
      "default": ""
    }
  ]
}