{
  "id": "jellyseerr",
  "name": "Jellyseerr",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Jellyseer is a free and open source software application for managing requests for your media library",
  "description": "Jellyseer is a free and open source software application for managing requests for your media library.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/Qballjos/portainer_templates/master/Images/jellyseerr.png",
  "default_port": 5055,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/Jellyseerr",
      "container": "/app/config",
      "description": "Dossier /app/config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}