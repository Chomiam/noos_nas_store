{
  "id": "dokemon",
  "name": "Dokemon",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Deploy compose files, start/stop containers, delete unused images, view logs",
  "description": "Deploy compose files, start/stop containers, delete unused images, view logs",
  "website": "",
  "icon": "https://dokemon.dev/logo/dokemon-dark-medium.svg",
  "default_port": 9090,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}