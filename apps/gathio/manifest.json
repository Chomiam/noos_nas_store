{
  "id": "gathio",
  "name": "Gathio",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Gathio is a simple, federated, privacy-first event hosting platform",
  "description": "Gathio is a simple, federated, privacy-first event hosting platform.",
  "website": "",
  "icon": "https://gath.io/og-image.jpg",
  "default_port": 3022,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}