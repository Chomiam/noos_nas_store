{
  "id": "httpd",
  "name": "Httpd",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source HTTP server",
  "description": "Open-source HTTP server",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/httpd.png",
  "default_port": 80,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/usr_local_apache2_htdocs",
      "container": "/usr/local/apache2/htdocs/",
      "description": "Dossier /usr/local/apache2/htdocs/"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}