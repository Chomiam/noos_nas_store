{
  "id": "tiddlywiki",
  "name": "TiddlyWiki",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A unique, non-linear notebook wiki",
  "description": "A unique, non-linear notebook wiki.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/tiddlywiki.png",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/TiddlyWiki",
      "container": "/var/lib/tiddlywiki",
      "description": "Dossier /var/lib/tiddlywiki"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}