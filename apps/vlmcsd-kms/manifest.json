{
  "id": "vlmcsd-kms",
  "name": "Vlmcsd - KMS",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "This is a replacement for Microsoft's KMS server",
  "description": "This is a replacement for Microsoft's KMS server.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/vlmcsd.png",
  "default_port": 1688,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}