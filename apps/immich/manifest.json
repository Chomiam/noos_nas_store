{
  "id": "immich",
  "name": "Immich {shmolf}",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "Self-hosted backup solution for photos and videos on mobile device",
  "description": "Self-hosted backup solution for photos and videos on mobile device.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/shmolf/portainer-templates/main/assets/logos/immich-logo.svg",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}