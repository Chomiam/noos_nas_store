{
  "id": "kometa",
  "name": "Kometa",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "[Kometa](https://github",
  "description": "[Kometa](https://github.com/Kometa-Team/Kometa) is a powerful tool designed to give you complete control over your media libraries. With Kometa, you can take your customization to the next level, with granular control over metadata, collections, overlays, and much more.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/kometa-banner.png",
  "default_port": 80,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "KOMETA_CONFIG",
      "label": "KOMETA_CONFIG",
      "default": "/config/config.yml"
    },
    {
      "name": "KOMETA_TIMES",
      "label": "KOMETA_TIMES",
      "default": "03:00"
    },
    {
      "name": "KOMETA_RUN",
      "label": "KOMETA_RUN",
      "default": "False"
    },
    {
      "name": "KOMETA_TESTS",
      "label": "KOMETA_TESTS",
      "default": "False"
    },
    {
      "name": "KOMETA_NO_MISSING",
      "label": "KOMETA_NO_MISSING",
      "default": "False"
    }
  ]
}