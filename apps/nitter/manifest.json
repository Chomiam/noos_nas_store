{
  "id": "nitter",
  "name": "Nitter",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "A free and open source alternative Twitter front-end focused on privacy and performance",
  "description": "A free and open source alternative Twitter front-end focused on privacy and performance.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/nitter.png",
  "default_port": 3300,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}