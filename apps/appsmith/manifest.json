{
  "id": "appsmith",
  "name": "Appsmith",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "Appsmith (www",
  "description": "Appsmith (www.appsmith.com) is the first open-source low-code tool that helps developers build dashboards and admin panels very quickly.",
  "website": "",
  "icon": "https://cdn-images.himalayas.app/vr60veq4neiptamhqm6qxwi3toi3",
  "default_port": 1810,
  "extra_ports": [
    1443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}