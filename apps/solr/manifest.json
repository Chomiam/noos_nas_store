{
  "id": "solr",
  "name": "Solr",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source enterprise search platform",
  "description": "Open-source enterprise search platform",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/solr.png",
  "default_port": 8983,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/opt_solr_mydata",
      "container": "/opt/solr/mydata",
      "description": "Dossier /opt/solr/mydata"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}