{
  "id": "linkding",
  "name": "Linkding",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "Self-hosted bookmark manager that is minimal and fast",
  "description": "Self-hosted bookmark manager that is minimal and fast. Source: https://github.com/sissbruecker/linkding",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/357820",
  "default_port": 9090,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/etc_linkding_data",
      "container": "/etc/linkding/data",
      "description": "Dossier /etc/linkding/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "LD_SUPERUSER_NAME",
      "label": "Admin username",
      "default": "admin"
    },
    {
      "name": "LD_SUPERUSER_PASSWORD",
      "label": "Admin password",
      "default": "changeme"
    },
    {
      "name": "LD_SUPERUSER_EMAIL",
      "label": "Admin email (optional)",
      "default": ""
    }
  ]
}