{
  "id": "lazylibrarian",
  "name": "Lazylibrarian",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "[Lazylibrarian](https://lazylibrarian",
  "description": "[Lazylibrarian](https://lazylibrarian.gitlab.io/) is a program to follow authors and grab metadata for all your digital reading needs. It uses a combination of Goodreads Librarything and optionally GoogleBooks as sources for author info and book info. This container is based on the DobyTang fork.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/lazylibrarian-icon.png",
  "default_port": 5299,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/downloads",
      "container": "/downloads",
      "description": "Dossier /downloads"
    },
    {
      "host": "./data/books",
      "container": "/books",
      "description": "Dossier /books"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "DOCKER_MODS",
      "label": "DOCKER_MODS",
      "default": "linuxserver/mods:universal-calibre|linuxserver/mods:lazylibrarian-ffmpeg"
    }
  ]
}