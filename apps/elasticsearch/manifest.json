{
  "id": "elasticsearch",
  "name": "Elasticsearch",
  "version": "latest",
  "category": "Développement",
  "tagline": "Open-source search and analytics engine",
  "description": "Open-source search and analytics engine",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/elasticsearch.png",
  "default_port": 9200,
  "extra_ports": [
    9300
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/usr_share_elasticsearch_data",
      "container": "/usr/share/elasticsearch/data",
      "description": "Dossier /usr/share/elasticsearch/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "discovery.type",
      "label": "discovery.type",
      "default": "single-node"
    },
    {
      "name": "xpack.security.enabled",
      "label": "Disable X-Pack security",
      "default": "false"
    }
  ]
}