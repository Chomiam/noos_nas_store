{
  "id": "commandbox",
  "name": "CommandBox",
  "version": "latest",
  "category": "Développement",
  "tagline": "ColdFusion (CFML) CLI",
  "description": "ColdFusion (CFML) CLI",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/ortussolutions-commandbox.png",
  "default_port": 8080,
  "extra_ports": [
    8443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Données et configuration"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "CFENGINE",
      "label": "CFENGINE",
      "default": "lucee@4.5"
    }
  ]
}