{
  "id": "dagu",
  "name": "Dagu",
  "version": "latest",
  "category": "Domotique & IoT",
  "tagline": "A powerful, self-contained DAG-based job scheduler with a web UI, YAML definitions, and no dependencies",
  "description": "A powerful, self-contained DAG-based job scheduler with a web UI, YAML definitions, and no dependencies. Source: https://github.com/dagu-org/dagu",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/131097250",
  "default_port": 8080,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_dagu",
      "container": "/var/lib/dagu",
      "description": "Dossier /var/lib/dagu"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}