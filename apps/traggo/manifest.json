{
  "id": "traggo",
  "name": "Traggo",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Traggo is a tag-based time tracking tool",
  "description": "Traggo is a tag-based time tracking tool. In Traggo there are no tasks, only tagged time spans.",
  "website": "",
  "icon": "https://traggo.net/images/favicon.png",
  "default_port": 3030,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}