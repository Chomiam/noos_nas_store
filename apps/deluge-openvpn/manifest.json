{
  "id": "deluge-openvpn",
  "name": "Deluge openvpn",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "This container contains OpenVPN and Deluge with a configuration where Deluge is running only when OpenVPN has an active ",
  "description": "This container contains OpenVPN and Deluge with a configuration where Deluge is running only when OpenVPN has an active tunnel. It bundles configuration files for many popular VPN providers to make the setup easier.",
  "website": "",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/deluge-openvpn.png",
  "default_port": 8112,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "description": "Dossier /etc/localtime"
    },
    {
      "host": "./data/Downloads",
      "container": "/downloads",
      "description": "Dossier /downloads"
    },
    {
      "host": "./data/DelugeOpenVPN/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "OPENVPN_PROVIDER",
      "label": "OPENVPN_PROVIDER",
      "default": "MULLVAD"
    },
    {
      "name": "OPENVPN_USERNAME",
      "label": "OPENVPN_USERNAME",
      "default": ""
    },
    {
      "name": "OPENVPN_PASSWORD",
      "label": "OPENVPN_PASSWORD",
      "default": ""
    }
  ]
}