{
  "id": "cloudbeaver",
  "name": "CloudBeaver",
  "version": "latest",
  "category": "Développement",
  "tagline": "Cloud database manager providing a web interface for working with various databases",
  "description": "Cloud database manager providing a web interface for working with various databases. Source: https://github.com/dbeaver/cloudbeaver",
  "website": "",
  "icon": "https://avatars.githubusercontent.com/u/34743864",
  "default_port": 8978,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/opt_cloudbeaver_workspace",
      "container": "/opt/cloudbeaver/workspace",
      "description": "Dossier /opt/cloudbeaver/workspace"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}