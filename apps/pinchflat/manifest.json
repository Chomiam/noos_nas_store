{
  "id": "pinchflat",
  "name": "Pinchflat",
  "version": "latest",
  "category": "Multimédia",
  "tagline": "Your next YouTube media manager",
  "description": "Your next YouTube media manager",
  "website": "",
  "icon": "https://github.com/kieraneglin/pinchflat/raw/master/priv/static/images/originals/logo-white-wordmark-with-background.png",
  "default_port": 8945,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}