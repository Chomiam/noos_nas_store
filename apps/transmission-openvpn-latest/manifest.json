{
  "id": "transmission-openvpn-latest",
  "name": "Transmission OpenVPN Latest",
  "version": "latest",
  "category": "Sécurité & Réseau",
  "tagline": "This container contains OpenVPN and Transmission with a configuration\nwhere Transmission is running only when OpenVPN ha",
  "description": "This container contains OpenVPN and Transmission with a configuration\nwhere Transmission is running only when OpenVPN has an active tunnel.\nIt bundles configuration files for many popular VPN providers to make the setup easier.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/transmission-icon.png",
  "default_port": 9091,
  "extra_ports": [],
  "recommended": true,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/transmission-openvpn",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/Downloads",
      "container": "/data",
      "description": "Dossier /data"
    },
    {
      "host": "./data/localtime",
      "container": "/etc/localtime",
      "description": "Dossier /etc/localtime"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "OPENVPN_PROVIDER",
      "label": "OPENVPN_PROVIDER",
      "default": "MULLVAD"
    },
    {
      "name": "OPENVPN_CONFIG",
      "label": "OPENVPN_CONFIG",
      "default": ""
    },
    {
      "name": "OPENVPN_USERNAME",
      "label": "OPENVPN_USERNAME",
      "default": ""
    },
    {
      "name": "OPENVPN_PASSWORD",
      "label": "OPENVPN_PASSWORD",
      "default": ""
    },
    {
      "name": "LOCAL_NETWORK",
      "label": "LOCAL_NETWORK",
      "default": "192.168.0.0/24"
    },
    {
      "name": "TRANSMISSION_WATCH_DIR_ENABLED",
      "label": "watch-dir-enabled",
      "default": "true"
    }
  ]
}