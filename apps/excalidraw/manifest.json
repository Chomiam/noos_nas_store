{
  "id": "excalidraw",
  "name": "Excalidraw",
  "version": "latest",
  "category": "Finance & Organisation",
  "tagline": "Virtual whiteboard for sketching hand-drawn like diagrams",
  "description": "Virtual whiteboard for sketching hand-drawn like diagrams. Collaborative and end-to-end encrypted.",
  "website": "",
  "icon": "https://github.com/excalidraw/excalidraw/raw/master/public/og-image-sm.png",
  "default_port": 3111,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data",
      "container": "/data",
      "description": "Données de la stack"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    }
  ]
}