{
  "id": "babybuddy",
  "name": "Babybuddy",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "[Babybuddy](https://github",
  "description": "[Babybuddy](https://github.com/babybuddy/babybuddy) is a buddy for babies! Helps caregivers track sleep, feedings, diaper changes, tummy time and more to learn about and predict baby's needs without (as much) guess work.",
  "website": "",
  "icon": "https://github.com/linuxserver/docker-templates/raw/master/linuxserver.io/img/babybuddy-logo.png",
  "default_port": 8000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/config",
      "container": "/config",
      "description": "Dossier /config"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "CSRF_TRUSTED_ORIGINS",
      "label": "CSRF_TRUSTED_ORIGINS",
      "default": "http://127.0.0.1:8000,https://babybuddy.domain.com"
    }
  ]
}