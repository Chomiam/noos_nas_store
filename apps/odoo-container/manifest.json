{
  "id": "odoo-container",
  "name": "Odoo (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source business apps",
  "description": "Open-source business apps",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/odoo.png",
  "default_port": 8069,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_odoo",
      "container": "/var/lib/odoo",
      "description": "Dossier /var/lib/odoo"
    },
    {
      "host": "./data/mnt_extra-addons",
      "container": "/mnt/extra-addons",
      "description": "Dossier /mnt/extra-addons"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "HOST",
      "label": "PostgreSQL database host",
      "default": ""
    },
    {
      "name": "USER",
      "label": "Database user",
      "default": ""
    },
    {
      "name": "PASSWORD",
      "label": "Database password",
      "default": ""
    }
  ]
}