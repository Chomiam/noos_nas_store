{
  "id": "wizarr",
  "name": "Wizarr",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Wizarr is an advanced user invitation and management system for Jellyfin, Plex, Emby etc",
  "description": "Wizarr is an advanced user invitation and management system for Jellyfin, Plex, Emby etc.",
  "website": "",
  "icon": "https://mediadepot.github.io/templates/img/wizarr-logo.png",
  "default_port": 5690,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/apps/wizarr",
      "container": "/data/database",
      "description": "Dossier /data/database"
    },
    {
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "description": "Dossier /etc/localtime"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "APP_URL",
      "label": "APP_URL",
      "default": "https://wizarr.domain.com"
    }
  ]
}