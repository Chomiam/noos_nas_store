{
  "id": "netbootxyz",
  "name": "Netboot.xyz (container)",
  "version": "latest",
  "category": "Téléchargement",
  "tagline": "Netbootxyz is a way to PXE boot various operating system installers or utilities from one place within the BIOS without ",
  "description": "Netbootxyz is a way to PXE boot various operating system installers or utilities from one place within the BIOS without the need of having to go retrieve the media to run the tool",
  "website": "",
  "icon": "https://mediadepot.github.io/templates/img/netbootxyz.jpg",
  "default_port": 3000,
  "extra_ports": [
    69
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/apps/netbootxyz",
      "container": "/config",
      "description": "Dossier /config"
    },
    {
      "host": "./data/netbootxyz",
      "container": "/assets",
      "description": "Dossier /assets"
    },
    {
      "host": "./data/localtime",
      "container": "/etc/localtime",
      "description": "Dossier /etc/localtime"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}