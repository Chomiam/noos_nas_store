{
  "id": "nginx",
  "name": "Nginx",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "High performance web server",
  "description": "High performance web server",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/nginx.png",
  "default_port": 80,
  "extra_ports": [
    443
  ],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/etc_nginx",
      "container": "/etc/nginx",
      "description": "Dossier /etc/nginx"
    },
    {
      "host": "./data/usr_share_nginx_html",
      "container": "/usr/share/nginx/html",
      "description": "Dossier /usr/share/nginx/html"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}