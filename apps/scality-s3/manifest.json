{
  "id": "scality-s3",
  "name": "Scality S3",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Standalone AWS S3 protocol server",
  "description": "Standalone AWS S3 protocol server",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/scality-s3.png",
  "default_port": 8000,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/usr_src_app_localData",
      "container": "/usr/src/app/localData",
      "description": "Dossier /usr/src/app/localData"
    },
    {
      "host": "./data/usr_src_app_localMetadata",
      "container": "/usr/src/app/localMetadata",
      "description": "Dossier /usr/src/app/localMetadata"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "SCALITY_ACCESS_KEY",
      "label": "Scality S3 access key",
      "default": ""
    },
    {
      "name": "SCALITY_SECRET_KEY",
      "label": "Scality S3 secret key",
      "default": ""
    }
  ]
}