{
  "id": "snibox",
  "name": "Snibox (container)",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Self-hosted snippet manager",
  "description": "Self-hosted snippet manager.",
  "website": "",
  "icon": "https://raw.githubusercontent.com/Qballjos/portainer_templates/master/Images/snibox.png",
  "default_port": 3010,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/Snibox",
      "container": "/app/db/database",
      "description": "Dossier /app/db/database"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    }
  ]
}