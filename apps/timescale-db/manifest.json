{
  "id": "timescale-db",
  "name": "Timescale DB",
  "version": "latest",
  "category": "Outils & Utilitaires",
  "tagline": "Open-source time series database developed by Timescale Inc",
  "description": "Open-source time series database developed by Timescale Inc",
  "website": "",
