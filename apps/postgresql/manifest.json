{
  "id": "postgresql",
  "name": "PostgreSQL",
  "version": "latest",
  "category": "Développement",
  "tagline": "The most advanced open-source database",
  "description": "The most advanced open-source database",
  "website": "",
  "icon": "https://portainer-io-assets.sfo2.digitaloceanspaces.com/logos/postgres.png",
  "default_port": 5432,
  "extra_ports": [],
  "recommended": false,
  "type": "compose",
  "compose_file": "compose.yaml",
  "volumes": [
    {
      "host": "./data/var_lib_postgresql_data",
      "container": "/var/lib/postgresql/data",
      "description": "Dossier /var/lib/postgresql/data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "label": "Fuseau horaire",
      "default": "Europe/Paris"
    },
    {
      "name": "PUID",
      "label": "User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "default": "100"
    },
    {
      "name": "POSTGRES_USER",
      "label": "Superuser",
      "default": ""
    },
    {
      "name": "POSTGRES_PASSWORD",
      "label": "Superuser password",
      "default": ""
    }
  ]
}